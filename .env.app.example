# App server (cmd/server) — every variable config.Load() reads.

# Public port
PORT=8080
BASE_URL=http://localhost:8080

# Emailer link
EMAILER_ADDR=localhost:50052
EMAILER_SERVER_NAME=emailer

# mTLS material
TLS_CERT_FILE=certs/client.crt
TLS_KEY_FILE=certs/client.key
TLS_CA_FILE=certs/ca.crt

# GitHub
GITHUB_TOKEN=your_github_token

# Scanner
SCAN_INTERVAL=10m
SCAN_WORKERS=5

# API key
API_KEY=your_api_key

# Datastores
DATABASE_URL=postgres://your_username:your_password@localhost:5432/your_database?sslmode=disable
REDIS_URL=redis://:your_redis_password@localhost:6379

# Log level (debug, info, warn, error)
LOG_LEVEL=info
