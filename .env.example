# Full stack for `docker compose up` — copy to .env and fill in the secrets.
# To run a single binary directly instead, use .env.app.example / .env.emailer.example.

# App server
PORT=8080
BASE_URL=http://localhost:8080

# Emailer link & ports
EMAILER_ADDR=localhost:50052
EMAILER_SERVER_NAME=emailer
EMAILER_GRPC_PORT=50052
EMAILER_HTTP_PORT=8081

# mTLS material
TLS_CERT_FILE=certs/client.crt
TLS_KEY_FILE=certs/client.key
TLS_CA_FILE=certs/ca.crt

# GitHub
GITHUB_TOKEN=your_github_token

# Scanner
SCAN_INTERVAL=10m
SCAN_WORKERS=5

# SMTP
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=smtp_user
SMTP_PASSWORD=smtp_password
SMTP_FROM=noreply@example.com

# API key
API_KEY=your_api_key

# Log level (debug, info, warn, error)
LOG_LEVEL=info

# PostgreSQL
DB_PORT=5432
DB_USER=your_username
DB_PASSWORD=your_password
DB_NAME=your_database
DB_SSL_MODE=disable

# Redis
REDIS_PORT=6379
REDIS_PASSWORD=your_redis_password

# Elasticsearch
ES_JAVA_OPTS='-Xms512m -Xmx512m'
ES_PORT=9200

# Kibana
KIBANA_PORT=5601

# Prometheus
PROMETHEUS_PORT=9090

# Grafana
GRAFANA_PORT=3000
GRAFANA_PASSWORD=admin

# Connection URLs
DATABASE_URL=postgres://your_username:your_password@localhost:5432/your_database?sslmode=disable
REDIS_URL=redis://:your_redis_password@localhost:6379
