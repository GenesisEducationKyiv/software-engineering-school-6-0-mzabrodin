# Subscription service
SUBSCRIPTION_PORT=8080
BASE_URL=http://localhost:8080
JWT_SECRET=your_jwt_secret
CONFIRM_TOKEN_TTL=24h
PENDING_CLEANUP_INTERVAL=24h
API_KEY=your_api_key

# Scanner service
SCANNER_PORT=8082
SCAN_INTERVAL=10m
SCAN_WORKERS=5

# Notifier service
NOTIFIER_PORT=8081
RETRY_INTERVAL=15m
MAX_RETRIES=5
CONFIRMATION_TTL=24h
PROCESSED_RELEASE_TTL=720h

# SMTP
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=smtp_user
SMTP_PASSWORD=smtp_password
SMTP_FROM=noreply@example.com

# GitHub
GITHUB_TOKEN=your_github_token

# Log Level (debug, info, warn, error)
LOG_LEVEL=info

# Message broker
NATS_URL=nats://nats:4222

# PostgreSQL
DB_USER=your_username
DB_PASSWORD=your_password
DB_SSL_MODE=disable
SUBSCRIPTION_DB_NAME=your_subscription_database
SCANNER_DB_NAME=your_scanner_database
NOTIFIER_DB_NAME=your_notifier_database
SUBSCRIPTION_DB_PORT=5432
SCANNER_DB_PORT=5433
NOTIFIER_DB_PORT=5434

# Redis
REDIS_PORT=6379
REDIS_PASSWORD=your_redis_password

# Observability
ES_JAVA_OPTS='-Xms512m -Xmx512m'
KIBANA_PORT=5601
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
GRAFANA_PASSWORD=admin
