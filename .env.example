# Full stack for `docker compose up` — copy to .env and fill in the secrets.
# To run a single binary directly, use .env.subscription.example / .env.scanner.example / .env.notifier.example.

# Subscription service (public API)
SUBSCRIPTION_PORT=8080
BASE_URL=http://localhost:8080

# Confirmation tokens (stateless JWTs, issued at subscribe / verified at confirm)
JWT_SECRET=your_jwt_secret

# Scanner/notifier service ports
SCANNER_PORT=8082
NOTIFIER_PORT=8081

# Message broker — services publish/consume domain events over JetStream
NATS_URL=nats://localhost:4222

# GitHub
GITHUB_TOKEN=your_github_token

# Scan loop
SCAN_INTERVAL=10m
SCAN_WORKERS=5

# Confirm-token TTL + pending-subscription cleanup cadence (subscription)
CONFIRM_TOKEN_TTL=24h
PENDING_CLEANUP_INTERVAL=24h

# SMTP
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=smtp_user
SMTP_PASSWORD=smtp_password
SMTP_FROM=noreply@example.com

# Release retry + dedupe (notifier)
RETRY_INTERVAL=15m
MAX_RETRIES=5
CONFIRMATION_TTL=24h
PROCESSED_RELEASE_TTL=720h

# API key
API_KEY=your_api_key

# Log level (debug, info, warn, error)
LOG_LEVEL=info

# PostgreSQL (database-per-service: subscription owns DB_NAME, scanner owns SCANNER_DB_NAME, notifier owns NOTIFIER_DB_NAME)
SUBSCRIPTION_DB_PORT=5432
SCANNER_DB_PORT=5433
NOTIFIER_DB_PORT=5434
DB_USER=your_username
DB_PASSWORD=your_password
SUBSCRIPTION_DB_NAME=your_database
SCANNER_DB_NAME=your_scanner_database
NOTIFIER_DB_NAME=your_notifier_database
DB_SSL_MODE=disable

# Redis
REDIS_PORT=6379
REDIS_PASSWORD=your_redis_password

# Elasticsearch
ES_JAVA_OPTS='-Xms512m -Xmx512m'
ES_PORT=9200

# Kibana
KIBANA_PORT=5601

# Prometheus
PROMETHEUS_PORT=9090

# Grafana
GRAFANA_PORT=3000
GRAFANA_PASSWORD=admin

# Connection URLs
DATABASE_URL=postgres://your_username:your_password@localhost:5432/your_database?sslmode=disable
REDIS_URL=redis://:your_redis_password@localhost:6379
