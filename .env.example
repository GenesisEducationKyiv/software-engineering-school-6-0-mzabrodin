# Server
HTTP_PORT=8080
GRPC_PORT=50051
BASE_URL=http://localhost:8080

# GitHub Token
GITHUB_TOKEN=your_github_token

# Scanner
SCAN_INTERVAL=10m
SCAN_WORKERS=5

# PostgreSQL
DB_PORT=5432
DB_USER=your_username
DB_PASSWORD=your_password
DB_NAME=your_database
DB_SSL_MODE=disable

# Redis
REDIS_PORT=6379
REDIS_PASSWORD=your_redis_password

# SMTP
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=smtp_user
SMTP_PASSWORD=smtp_password
SMTP_FROM=noreply@example.com

# API Key
API_KEY=your_api_key

# Log level (debug, info, warn, error)
LOG_LEVEL=info

# Elasticsearch JVM heap (tune down on low-memory machines, up for production) and port
ES_JAVA_OPTS='-Xms512m -Xmx512m'
ES_PORT=9200

# Kibana
KIBANA_PORT=5601

# Prometheus
PROMETHEUS_PORT=9090

# Grafana
GRAFANA_PORT=3000
GRAFANA_PASSWORD=admin

# Connection URLs constructed automatically in Docker
DATABASE_URL=postgres://your_username:your_password@localhost:5432/your_database?sslmode=disable
REDIS_URL=redis://:your_redis_password@localhost:6379
