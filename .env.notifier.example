# Notifier service (cmd/notifier) — every variable config.LoadNotifier() reads.

# Metrics/health port
NOTIFIER_HTTP_PORT=8081

# Message broker — the notifier consumes subscription/release events from here
NATS_URL=nats://localhost:4222

# Datastore — the notifier owns its own database (read model + retry/dedupe tables)
DATABASE_URL=postgres://your_username:your_password@localhost:5432/your_notifier_database?sslmode=disable

# Public base URL — used to build the unsubscribe link in release emails
BASE_URL=http://localhost:8080

# Retry/dead-letter ticker
RETRY_INTERVAL=15m
MAX_RETRIES=5

# How long a confirmation link stays retryable before it is dead-lettered (matches the JWT TTL)
CONFIRMATION_TTL=24h

# How long processed_releases rows are kept before pruning
PROCESSED_RELEASE_TTL=720h

# SMTP
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=smtp_user
SMTP_PASSWORD=smtp_password
SMTP_FROM=noreply@example.com

# Log level (debug, info, warn, error)
LOG_LEVEL=info
