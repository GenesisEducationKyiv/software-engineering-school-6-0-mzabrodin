# Scanner service (cmd/scanner) — every variable config.LoadScanner() reads.

# gRPC port (mTLS, dialed by the app) + metrics/health port
SCANNER_GRPC_PORT=50051
SCANNER_HTTP_PORT=8082

# mTLS material — mounts the server cert
TLS_CERT_FILE=certs/scanner.crt
TLS_KEY_FILE=certs/scanner.key
TLS_CA_FILE=certs/ca.crt

# GitHub
GITHUB_TOKEN=your_github_token

# Fetch concurrency
SCAN_WORKERS=5

# Redis (GitHub response cache)
REDIS_URL=redis://:your_redis_password@localhost:6379

# Log level (debug, info, warn, error)
LOG_LEVEL=info
