# Scanner service (cmd/scanner) — every variable config.LoadScanner() reads.

# Metrics/health port
SCANNER_HTTP_PORT=8082

# GitHub
GITHUB_TOKEN=your_github_token

# Scan loop — interval between passes + fetch concurrency
SCAN_INTERVAL=10m
SCAN_WORKERS=5

# Datastore — the scanner owns its own database (watched_repos)
DATABASE_URL=postgres://your_username:your_password@localhost:5432/your_scanner_database?sslmode=disable

# Redis (GitHub response cache)
REDIS_URL=redis://:your_redis_password@localhost:6379

# Message broker — the scanner consumes subscription events and publishes releases here
NATS_URL=nats://localhost:4222

# Log level (debug, info, warn, error)
LOG_LEVEL=info
