# Emailer service (cmd/emailer) — every variable config.LoadEmailer() reads.

# Metrics/health port
EMAILER_HTTP_PORT=8081

# Message broker — the emailer consumes email commands from here
NATS_URL=nats://localhost:4222

# SMTP
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=smtp_user
SMTP_PASSWORD=smtp_password
SMTP_FROM=noreply@example.com

# Log level (debug, info, warn, error)
LOG_LEVEL=info
