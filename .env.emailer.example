# Emailer service (cmd/emailer) — every variable config.LoadEmailer() reads.

# gRPC port (mTLS, dialed by the app) & metrics/health port
EMAILER_GRPC_PORT=50052
EMAILER_HTTP_PORT=8081

# mTLS material — mounts the server cert
TLS_CERT_FILE=certs/emailer.crt
TLS_KEY_FILE=certs/emailer.key
TLS_CA_FILE=certs/ca.crt

# SMTP
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=smtp_user
SMTP_PASSWORD=smtp_password
SMTP_FROM=noreply@example.com

# Log level (debug, info, warn, error)
LOG_LEVEL=info
